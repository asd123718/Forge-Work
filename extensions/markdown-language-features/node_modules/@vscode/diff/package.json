{
  "name": "@vscode/diff",
  "version": "0.0.2-0",
  "description": "A high-performance diff algorithm implementation with WASM backend, ported from VS Code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build:wasm": "cd rust && wasm-pack build --target web --out-dir ../out/pkg",
    "build:js": "rollup -c",
    "build": "npm run build:wasm && npm run build:js",
    "test": "vitest --run",
    "pack:tgz": "npm run build && node -e \"require('fs').mkdirSync('dist-pack',{recursive:true})\" && npm pack --pack-destination dist-pack",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/vscode-packages.git",
    "directory": "vscode-diff"
  },
  "keywords": [
    "diff",
    "lcs",
    "vscode",
    "wasm",
    "rust"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microsoft/vscode-packages/issues"
  },
  "homepage": "https://github.com/microsoft/vscode-packages/tree/main/vscode-diff",
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^25.7.0",
    "@web/rollup-plugin-import-meta-assets": "^2.3.3",
    "rollup": "^4.34.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
